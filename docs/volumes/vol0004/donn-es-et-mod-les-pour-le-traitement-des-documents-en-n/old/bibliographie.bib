@article{gefenEnjeuxEpistemologiquesHumanites2015,
  title = {Les enjeux épistémologiques des humanités numériques},
  author = {Gefen, Alexandre},
  year ={2015},
  journal ={Socio. La nouvelle revue des sciences sociales},
  volume = {4},
  number = {},
  pages = {61--74},
  publisher = {Éditions de la maison des sciences de l’homme},
  issn = {2266-3134},
  doi = {10.4000/socio.1296},
  url = {https://journals.openedition.org/socio/1296},
  urlyear ={2024-04-11},
  abstract = {En sciences humaines comme en science dures, les numérisations massives des textes et des données produisent depuis plus d’une décennie des big data ou long data ouvrant des pistes de recherche novatrices. Mais les méthodes critiques qui les accompagnent ont des enjeux épistémologiques, institutionnels et pédagogiques considérables. Dans ce qu’on appelle désormais les « humanités numériques », la lecture à distance de corpus constitués par des cartes et graphes offre une forme spécifique de savoir et un paradigme méthodologique et épistémologique qu’il importe de saisir dans toute sa puissante heuristique, sans se laisser entraîner par l’idée naïve d’une production transparente de savoirs par moissonnage des corpus, masse de données qui restent des artéfacts muets en l’absence d’une herméneutique spécifique.},
  isbn = {9782735120352},
  issue = {4},
  langid = {french},
  keywords = {big data,critique,épistémologie des sciences sociales,histoire littéraire,humanités numériques,lexicographie,sciences collaboratives,sciences de la culture,théorie de la littérature},
  file = {/home/floriane/Zotero/storage/575PGUR3/Gefen - 2015 - Les enjeux épistémologiques des humanités numériqu.pdf}
}

