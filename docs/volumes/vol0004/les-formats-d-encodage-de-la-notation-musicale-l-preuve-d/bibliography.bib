	file = {Full Text PDF:/Users/hscheith/Zotero/storage/ZA7UMTPV/Fizaine et al. - 2024 - Historical Text Line Segmentation Using Deep Learning Algorithms Mask-RCNN against U-Net Networks.pdf:application/pdf},
