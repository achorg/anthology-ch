	journal = {International Journal of Multimedia Information Retrieval},
	author = {Rebelo, Ana and Fujinaga, Ichiro and Paszkiewicz, Filipe and Marcal, Andre R. S. and Guedes, Carlos and Cardoso, Jaime S.},
	month = oct,
