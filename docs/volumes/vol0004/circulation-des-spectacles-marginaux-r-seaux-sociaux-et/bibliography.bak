@incollection{bourdin_curiosites_2021,
	address = {Clermont-Ferrand},
	series = {Histoires croisées},
	title = {Les curiosités à la {Criée} ou les petits spectacles marseillais sous l’{Empire}},
	copyright = {https://www.openedition.org/12554},
	isbn = {978-2-38377-329-0},
	url = {https://books.openedition.org/pubp/16389},
	doi = {10.4000/13r2u},
	abstract = {With more than 200 cases of curiosity shows given in Marseille during the First Empire, this contribution reflects on the spaces occupied by artists to perform (streets, squares, cabarets, private houses). It tries to propose a diverse sociology of the saltimbanques and their spectators to establish a calendar of activities. Finally, it analyses the vision of the world, of humanity, of the history offered by aerostatic or acrobatic prowess, magic lanterns, wax or puppet theatres, walks of trained animals. This is a possible measure of what contemporaries and the authorities consider to be morally and socially acceptable.,À partir de plus de 200 cas de spectacles de curiosités donnés à Marseille sous le Premier Empire, cette contribution réfléchit aux espaces occupés par les artistes pour donner leurs numéros (rues, places, cabarets, maisons particulières). Elle essaie de proposer une sociologie diversifiée des saltimbanques et de leurs spectateurs, d’établir un calendrier des activités. Enfin, elle analyse la vision du monde, de l’humanité, de l’histoire proposée à partir des prouesses aérostatiques ou acrobatiques, des lanternes magiques, des théâtres de cires ou de marionnettes, des promenades d’animaux dressés. Il y a là une mesure possible de ce que les contemporains et les pouvoirs considèrent comme acceptable moralement et socialement.},
	urldate = {2026-01-13},
	booktitle = {Les espaces du spectacle vivant dans la ville : {Permanences}, mutations, hybridité (xviiie-xxie siècles)},
	publisher = {Presses universitaires Blaise-Pascal},
	author = {Bourdin, Philippe},
	editor = {Beaucé, Pauline and Dubouilh, Sandrine and Triolaire, Cyril},
	year = {2021},
	pages = {67--87},
}

